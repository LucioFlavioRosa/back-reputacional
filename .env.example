# Copie para .env e ajuste. Nunca versione o .env.
#
# Os valores abaixo são os de DESENVOLVIMENTO. Em produção, a conferência de
# subida (`plataforma/verificacao_de_producao.py`) recusa iniciar com vários
# deles — o que está comentado no fim é o que ela exige.

AMBIENTE=desenvolvimento
BANCO_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/painel_reputacional
# Log de toda consulta SQL, com os parâmetros. Útil para depurar, proibido em
# produção — os parâmetros incluem conteúdo dos registros.
BANCO_ECHO=false


# -- autenticação --------------------------------------------------------------
#
# Com AUTH_MOCK, um usuário fixo é provisionado pelo MESMO caminho do SSO real.
# Só a origem das claims muda; a forma da dependência é a mesma.
AUTH_MOCK=true
AUTH_MOCK_EMAIL=analista@aegea.com.br
AUTH_MOCK_NOME=Analista de Desenvolvimento
AUTH_MOCK_PERFIL=analista

# Registro do app no tenant. Obrigatórios quando AUTH_MOCK=false.
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# ENTRA_REDIRECT_URI=http://localhost:8000/api/auth/callback
#
# A autoridade só muda para nuvem soberana (Azure China, Government) ou para
# apontar a um provedor falso em teste.
# ENTRA_AUTORIDADE=https://login.microsoftonline.com

# Para onde o callback devolve o navegador depois de autenticar.
URL_DO_FRONT=http://localhost:5173

# Chave do cookie de sessão. Trocar invalida toda sessão viva.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSAO_SECRETA=desenvolvimento-nao-use-em-producao


# -- superfície HTTP -----------------------------------------------------------

# Lista explícita. Nunca use ["*"]: com credenciais, o curinga transforma
# qualquer origem aceita numa origem confiável.
ORIGENS_PERMITIDAS=["http://localhost:5173"]

# 1MB. O cadastro maior do sistema não chega a 50KB.
TAMANHO_MAXIMO_DO_CORPO=1048576

# /docs e /openapi.json. Em produção o padrão é ficarem fora do ar.
DOCS_PUBLICOS=true

# HSTS. Só ligue onde o HTTPS já esteja sólido: o navegador guarda o registro
# pelo prazo inteiro, e tirar o cabeçalho depois não cancela nada.
# HSTS_LIGADO=false
# HSTS_MAX_AGE=31536000
# HSTS_INCLUIR_SUBDOMINIOS=false


# -- limite de taxa ------------------------------------------------------------
#
# Os números saem do uso real: um recorte do painel custa ~25 requisições, e
# quem explora filtros faz vários recortes por minuto.
#
# Por IP é frouxo de propósito — atrás do NAT corporativo o escritório inteiro
# compartilha um endereço. Quem de fato limita é o balde por usuário.

LIMITE_DE_TAXA_LIGADO=true
LIMITE_POR_IP_CAPACIDADE=600
LIMITE_POR_IP_POR_SEGUNDO=40
LIMITE_POR_USUARIO_CAPACIDADE=120
LIMITE_POR_USUARIO_POR_SEGUNDO=8

# Quantos proxies confiáveis há na frente. ZERO ignora o X-Forwarded-For por
# completo e usa o endereço da conexão — o padrão seguro, porque o cabeçalho é
# forjável. Atrás do Front Door, 1.
PROXIES_CONFIAVEIS=0


# -- telemetria ----------------------------------------------------------------
#
# Sem a connection string nada é enviado e nada quebra: o log estruturado
# continua saindo em stdout.
# APPLICATIONINSIGHTS_CONNECTION_STRING=
NOME_DO_SERVICO=painel-reputacional-api


# =============================================================================
# PRODUÇÃO
#
# A conferência de subida separa duas coisas, e a diferença importa:
#
# BLOQUEIA — a API NÃO SOBE:
#
#   AUTH_MOCK=true
#   ENTRA_TENANT_ID / CLIENT_ID / CLIENT_SECRET ausentes
#   SESSAO_SECRETA no valor padrão, ou ausente
#   ORIGENS_PERMITIDAS com http, loopback ou rede privada
#   BANCO_URL apontando para localhost, ou sem sslmode
#   BANCO_ECHO=true
#   LIMITE_DE_TAXA_LIGADO=false, ou algum limite <= 0
#
# AVISA — a API sobe e registra o achado no log:
#
#   DOCS_PUBLICOS=true          as rotas somem mesmo assim; o aviso é para a
#                               intenção ficar explícita
#   PROXIES_CONFIAVEIS=0        se houver Front Door na frente, o limite por IP
#                               agrupa todo o tráfego num balde só
#   HSTS_LIGADO=false
#   APPLICATIONINSIGHTS_CONNECTION_STRING vazia
#
# Se a API sobe com AMBIENTE=producao, nenhum BLOQUEIO foi violado — mas vale
# ler os avisos no log da subida.
# =============================================================================
